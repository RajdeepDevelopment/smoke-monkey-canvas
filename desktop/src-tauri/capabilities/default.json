{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the Smoke Monkey Canvas desktop shell.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "dialog:allow-confirm",
    "dialog:allow-message",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:3333/**" },
        { "url": "http://127.0.0.1:3333/**" },
        { "url": "http://localhost:5173/**" },
        { "url": "http://127.0.0.1:5173/**" }
      ]
    }
  ]
}
