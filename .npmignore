# Inclusions are primarily controlled by "files" in package.json.
# This file prevents npm from falling back to .gitignore which ignores web/dist/.

# Tests & benchmarks
tests/
*.test.ts
test-*
*.tsbuildinfo

# Repository docs & cloud configs
.github/
.railway/
.do/
deploy/
docs/
scratch/

# Local databases & run artifacts
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/
storage/
.smoke-monkey/

# Web build/config exclusions (web/dist and web/src are both shipped; canvas-mcp.server.ts imports web/src)
web/node_modules/
web/index.html
web/vite.config.ts
web/tsconfig*.json
web/package.json
