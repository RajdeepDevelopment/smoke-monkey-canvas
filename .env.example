# 🐒 Smoke Monkey Canvas Environment Configuration Template
# Copy this file to .env and configure as needed.

# Application Server Port (default: 3333)
PORT=3333

# SQLite Database File Path
# Default for local machine: ~/.smoke-monkey/canvas.db
# Default for Docker container: /app/data/canvas.db
SMOKE_CANVAS_DB=/app/data/canvas.db

# Node Environment (production / development)
NODE_ENV=production

# Optional: Host binding (0.0.0.0 for containerized environments)
HOST=0.0.0.0

# Optional: External Database Port (if using Docker Compose Postgres MCP service)
# Configured to a non-standard port to prevent conflicts with local databases
POSTGRES_PORT=15432
POSTGRES_DB=smoke_monkey
POSTGRES_USER=canvas_user
POSTGRES_PASSWORD=your_secure_password_here
