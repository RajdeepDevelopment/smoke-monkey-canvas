{
  "apiVersion": "v1.2",
  "arguments": {
    "REGION": "europe-west"
  },
  "spec": {
    "kind": "Workflow",
    "spec": {
      "type": "sequential",
      "steps": [
        {
          "kind": "Project",
          "ref": "project",
          "spec": {
            "name": "smoke-monkey-canvas",
            "region": "${args.REGION}"
          }
        },
        {
          "kind": "Workflow",
          "spec": {
            "type": "sequential",
            "context": {
              "projectId": "${refs.project.id}"
            },
            "steps": [
              {
                "kind": "Volume",
                "ref": "canvasData",
                "spec": {
                  "name": "canvas-data",
                  "mounts": [
                    {
                      "containerMountPath": "/app/data"
                    }
                  ],
                  "spec": {
                    "accessMode": "ReadWriteOnce",
                    "storageSize": 5120
                  }
                }
              },
              {
                "kind": "DeploymentService",
                "ref": "canvas",
                "spec": {
                  "name": "smoke-monkey-canvas",
                  "billing": {
                    "deploymentPlan": "nf-compute-50"
                  },
                  "createOptions": {
                    "volumesToAttach": ["${refs.canvasData.id}"]
                  },
                  "deployment": {
                    "instances": 1,
                    "external": {
                      "imagePath": "rajdeepsadhu/smoke-monkey-canvas:latest"
                    }
                  },
                  "ports": [
                    {
                      "name": "http",
                      "internalPort": 3333,
                      "protocol": "HTTP",
                      "public": true
                    }
                  ],
                  "healthChecks": [
                    {
                      "protocol": "HTTP",
                      "type": "readinessProbe",
                      "path": "/api/space",
                      "port": 3333,
                      "initialDelaySeconds": 15,
                      "periodSeconds": 20,
                      "timeoutSeconds": 5,
                      "failureThreshold": 3,
                      "successThreshold": 1
                    }
                  ],
                  "runtimeEnvironment": {
                    "PORT": "3333",
                    "NODE_ENV": "production",
                    "SMOKE_CANVAS_DB": "/app/data/canvas.db"
                  }
                }
              }
            ]
          }
        }
      ]
    }
  }
}