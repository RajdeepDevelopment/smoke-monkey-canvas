# 🐒 Smoke Monkey Canvas — VPS Environment Template
# Copy to .env next to docker-compose.vps.yml and edit before deploying.
# Never commit the filled-in .env.

# ── Required ──────────────────────────────────────────────────────────────────
# Hostname for the server. Caddy requests a Let's Encrypt certificate for it, so
# an A record must already point at this server's public IP.
# Use a bare hostname (e.g. monkey.example.com), not a URL.
SMOKE_DOMAIN=monkey.example.com

# Caddy requests and renews the Let's Encrypt certificate for SMOKE_DOMAIN
# automatically. Nothing else to configure.

# ── Optional: Model Provider Keys ─────────────────────────────────────────────
# You do not need to set these here — keys can be entered in the Canvas UI,
# where they are encrypted at rest in the SQLite database. Set them here instead
# if you deploy via CI or provision infrastructure programmatically.
NVIDIA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=

# ── Only used with the optional `postgres` profile ─────────────────────────────
# Required if you run: docker compose --profile postgres up -d
POSTGRES_DB=smoke_monkey
POSTGRES_USER=canvas_user
POSTGRES_PASSWORD=