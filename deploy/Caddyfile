# 🐒 Smoke Monkey Canvas — Caddy Configuration
#
# Automatic TLS via Let's Encrypt: point an A/AAAA record for SMOKE_DOMAIN at
# this server's public IP and Caddy obtains and renews the certificate itself.
# WebSocket upgrades for /ws are handled natively by Caddy's reverse_proxy.
#
# Canvas requires a per-install bearer token (see SECURITY.md). The bundled web
# client sends it in an `X-Smoke-Monkey-Token` header rather than
# `Authorization`, so it can coexist with Caddy basic_auth below — the two do
# not compete for the same header.
#
# Add a login inside the block below, before reverse_proxy, e.g.:
#
#   basic_auth {
#     <username> <bcrypt-hash-from `caddy hash-password`>
#   }
#
# With basic_auth in place you can either set SMOKE_MONKEY_DISABLE_AUTH=1
# (basic_auth is now the only login) or keep the token layer and open the app
# once as https://<SMOKE_DOMAIN>/#token=<SMOKE_MONKEY_AUTH_TOKEN>. The fragment
# is never sent to the server, so the token stays out of access logs.

{$SMOKE_DOMAIN} {
	encode zstd gzip

	# Agent runs stream over WebSocket. Caddy proxies the upgrade transparently.
	reverse_proxy canvas:3333 {
		# Caddy's HTTP transport has no read/write timeout by default, so long
		# agent streams are not cut off mid-run.

		# By default Caddy force-closes WebSocket connections when its config is
		# reloaded. Delay that so a `caddy reload` does not kill a running agent.
		stream_close_delay 5m
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output stdout
		# Access logs record the request URI. A legacy ?token= link or a
		# WebSocket upgrade still carrying the token would put the installation
		# token in the log, so strip it — the UI uses #token= and the
		# Sec-WebSocket-Protocol header instead.
		format filter {
			wrap console
			fields {
				request>uri query {
					delete token
				}
				request>headers>X-Smoke-Monkey-Token delete
			}
		}
	}
}
